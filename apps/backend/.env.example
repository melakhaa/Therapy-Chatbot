# apps/backend/.env  — copy to .env, do not commit

# Backend connects as the non-superuser role so RLS applies (created by db/init/02_auth.sql)
DATABASE_URL=postgresql://sajiwa_app:sajiwa_app@localhost:5432/sajiwa

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me

ALLOWED_ORIGINS=*

# DeepSeek chat generation. Enable only for isolated synthetic staging or after privacy approval.
DEEPSEEK_ALLOW_CHAT_EGRESS=0
DEEPSEEK_API_KEY=
# Comma-separated exact metadata.source names of reviewed RAG documents; blank shares none.
DEEPSEEK_RAG_SOURCES=

# Lupa password: OTP dikirim lewat SMTP. Kosongkan SMTP_HOST di laptop dev -> OTP muncul di log server.
# Gmail: aktifkan verifikasi 2 langkah, lalu buat App Password (bukan kata sandi Gmail biasa).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sajiwa <alamat@gmail.com>
