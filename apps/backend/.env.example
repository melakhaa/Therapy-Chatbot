# apps/backend/.env  — copy to .env, do not commit

# Backend connects as the non-superuser role so RLS applies (created by db/init/02_auth.sql)
DATABASE_URL=postgresql://sajiwa_app:sajiwa_app@localhost:5432/sajiwa

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me

ALLOWED_ORIGINS=*

# Lupa password: OTP dikirim lewat SMTP. Kosongkan SMTP_HOST di laptop dev -> OTP muncul di log server.
# Gmail: aktifkan verifikasi 2 langkah, lalu buat App Password (bukan kata sandi Gmail biasa).
# Brevo (tanpa App Password): SMTP_HOST=smtp-relay.brevo.com, SMTP_USER = Login di SMTP & API > SMTP, SMTP_PASSWORD = SMTP key.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sajiwa <alamat@gmail.com>
