{
  "name": "prototype-monorepo",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "npm run test:unit",
    "test:unit": "npm run test:unit --workspaces --if-present && npm run backend:test:unit",
    "test:integration": "npm run backend:test:integration",
    "test:e2e": "node e2e/run.mjs",
    "backend:test:unit": "cd apps/backend && venv/bin/python -m unittest discover -s tests/unit",
    "backend:test:integration": "sh apps/backend/tests/integration/run.sh",
    "mobile:test": "npm run test:unit --workspace prototype"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "semver": "^7.7.4"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
