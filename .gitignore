# dependencies
node_modules/
.agent/
.agents/
.claude/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/apps/mobile/ios
/apps/mobile/android

# python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
# Local docker compose overrides (e.g. SAJIWA_DB_PORT)
/.env
*.zip

# local validation exports
/apps/dashboard/dist-*/

# testing artifacts: betterwright keeps sessions/profiles in ~/.betterwright, but a
# recording or screenshot saved beside a journey is transient
/e2e/**/*.png
/e2e/**/*.webm
/e2e/**/*.mp4

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
